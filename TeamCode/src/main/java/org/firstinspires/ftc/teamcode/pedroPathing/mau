    // ╔══════════════════════════════════════════════════════════╗
    // ║  ZONE 1: THÔNG SỐ TUNE                                 ║
    // ╚══════════════════════════════════════════════════════════╝

    // --- Thiết bị ---
    private static final String NAME_LIMELIGHT = "limelight";
    private static final int    LL_PIPELINE    = 8;
    private static final String NAME_S1 = "s1";
    private static final String NAME_S2 = "s2";
    private static final String NAME_S3 = "s3";
    private static final String NAME_S4 = "s4";
    private static final String NAME_S5 = "s5";

    // --- Limelight Scan (Cho hộp nhỏ 30cm) ---
    private static final double TX_THRESHOLD     = 8.0;
    private static final double TY_THRESHOLD     = 7.0;
    private static final int    SAMPLE_COUNT     = 13;    // Tăng mẫu cho hộp nhỏ
    private static final int    SAMPLE_DELAY     = 80;
    private static final long   LL_STARTUP_DELAY = 700;   // Đợi camera ổn định

    private static final double MIN_CONFIDENCE   = 35.0;  // Giảm cho hộp nhỏ/xa
    private static final double MIN_TARGET_AREA  = 0.005; // Giảm cho hộp nhỏ
    private static final int    MIN_SLOT_VOTES   = 3;
    private static final int    MIN_WIN_MARGIN   = 1;

    // --- Tên 4 hộp ---
    private static final String BOX_1 = "box01";
    private static final String BOX_2 = "box02";
    private static final String BOX_3 = "box03";
    private static final String BOX_4 = "box04";

    // --- Độ chính xác Pose (PICKUP) ---
    private static final double PICKUP_XY_TOLERANCE_IN      = 0.45;
    private static final double PICKUP_HEADING_TOLERANCE_DEG = 1.5;
    private static final long   PICKUP_STABLE_TIME_MS        = 350;
    private static final long   PICKUP_TIMEOUT_MS            = 2500;

    // --- Servo Home ---
    private static final double S1_HOME = 0.5;
    private static final double S2_HOME = 0.5;
    private static final double S3_HOME = 0.5;
    private static final double S4_HOME = 0.5;
    private static final double S5_HOME = 0.5;

    // --- Servo Delays ---
    private static final int SERVO_DELAY_FAST = 200;
    private static final int SERVO_DELAY_MED  = 400;
    private static final int SERVO_DELAY_SLOW = 600;

    // --- Servo Positions cho 4 Ô ---
    private static final double TL_S1 = 0.1; private static final double TL_S2 = 0.2;
    private static final double TL_S3 = 0.3; private static final double TL_S4 = 0.4;
    private static final double TL_S5 = 0.5;

    private static final double TR_S1 = 0.2; private static final double TR_S2 = 0.3;
    private static final double TR_S3 = 0.4; private static final double TR_S4 = 0.5;
    private static final double TR_S5 = 0.6;

    private static final double BL_S1 = 0.7; private static final double BL_S2 = 0.8;
    private static final double BL_S3 = 0.9; private static final double BL_S4 = 1.0;
    private static final double BL_S5 = 0.1;

    private static final double BR_S1 = 0.5; private static final double BR_S2 = 0.6;
    private static final double BR_S3 = 0.7; private static final double BR_S4 = 0.8;
    private static final double BR_S5 = 0.9;

    // ╔══════════════════════════════════════════════════════════╗
    // ║  ZONE 2: TỌA ĐỘ 3 KỆ                                   ║
    // ╚══════════════════════════════════════════════════════════╝
    private final Pose poseStart  = new Pose(0,   0,   Math.toRadians(0));
    private final Pose poseShelf1 = new Pose(48,  48,  Math.toRadians(90));
    private final Pose poseShelf2 = new Pose(48,  96,  Math.toRadians(180));
    private final Pose poseShelf3 = new Pose(0,   96,  Math.toRadians(270));
    private final Pose poseFinish = new Pose(0,   0,   Math.toRadians(0));

    // ╔══════════════════════════════════════════════════════════╗
    // ║  ZONE 3: CODE CHÍNH                                    ║
    // ╚══════════════════════════════════════════════════════════╝

    private Follower follower;
    private Limelight3A limelight;
    private Servo s1, s2, s3, s4, s5;

    private enum Slot { TOP_LEFT, TOP_RIGHT, BOT_LEFT, BOT_RIGHT, UNKNOWN }

    private String boxTL = "--", boxTR = "--", boxBL = "--", boxBR = "--";
    private String[] lastOrder = new String[4];
    private String[] lastViTri = new String[4];
    private Slot[]   lastSlots = new Slot[4];

    private int scanCount = 0;
    private int validDetectionCount = 0;
    private int rejectedDetectionCount = 0;
    private long lastScanTime = 0;
    private long scanStartTime = 0;
    private long stabilizeStartTime = 0;
    private long firstStableTime = 0;
    private Map<String, Integer> voteTL, voteTR, voteBL, voteBR;

    private PathChain pathToS1, pathS1toS2, pathS2toS3, pathS3toEnd;

    public void buildPaths() {
        pathToS1 = follower.pathBuilder()
                .addPath(new BezierLine(poseStart, poseShelf1))
                .setLinearHeadingInterpolation(poseStart.getHeading(), poseShelf1.getHeading())
                .build();
        pathS1toS2 = follower.pathBuilder()
                .addPath(new BezierLine(poseShelf1, poseShelf2))
                .setLinearHeadingInterpolation(poseShelf1.getHeading(), poseShelf2.getHeading())
                .build();
        pathS2toS3 = follower.pathBuilder()
                .addPath(new BezierLine(poseShelf2, poseShelf3))
                .setLinearHeadingInterpolation(poseShelf2.getHeading(), poseShelf3.getHeading())
                .build();
        pathS3toEnd = follower.pathBuilder()
                .addPath(new BezierLine(poseShelf3, poseFinish))
                .setLinearHeadingInterpolation(poseShelf3.getHeading(), poseFinish.getHeading())
                .build();
    }

    private void addVote(Map<String, Integer> map, String label) {
        if (label == null || label.equals("Unknown") || label.isEmpty()) return;
        Integer current = map.get(label);
        map.put(label, (current == null ? 0 : current) + 1);
    }

    private boolean isKnownBox(String label) {
        return BOX_1.equals(label) || BOX_2.equals(label) || BOX_3.equals(label) || BOX_4.equals(label);
    }

    private Slot txtyToSlot(double tx, double ty) {
        if (tx < -TX_THRESHOLD && ty < -TY_THRESHOLD) return Slot.TOP_LEFT;
        if (tx >  TX_THRESHOLD && ty < -TY_THRESHOLD) return Slot.TOP_RIGHT;
        if (tx < -TX_THRESHOLD && ty >  TY_THRESHOLD) return Slot.BOT_LEFT;
        if (tx >  TX_THRESHOLD && ty >  TY_THRESHOLD) return Slot.BOT_RIGHT;
        return Slot.UNKNOWN;
    }

    private boolean isGoodDetection(LLResultTypes.DetectorResult det) {
        return det != null
                && isKnownBox(det.getClassName())
                && det.getConfidence() >= MIN_CONFIDENCE
                && det.getTargetArea() >= MIN_TARGET_AREA
                && txtyToSlot(det.getTargetXDegrees(), det.getTargetYDegrees()) != Slot.UNKNOWN;
    }

    private String majority(Map<String, Integer> map) {
        if (map.isEmpty()) return "--";
        String best = "--";
        int bestVotes = 0;
        int secondVotes = 0;

        String[] labels = {BOX_1, BOX_2, BOX_3, BOX_4};
        for (String label : labels) {
            Integer votesObj = map.get(label);
            int votes = votesObj == null ? 0 : votesObj;
            if (votes > bestVotes) {
                secondVotes = bestVotes;
                bestVotes = votes;
                best = label;
            } else if (votes > secondVotes) {
                secondVotes = votes;
            }
        }

        if (bestVotes < MIN_SLOT_VOTES) return "--";
        if (bestVotes - secondVotes < MIN_WIN_MARGIN) return "--";
        return best;
    }

    private Command waitUntilPoseStable(Pose targetPose) {
        return Command.build()
                .setStart(() -> {
                    stabilizeStartTime = System.currentTimeMillis();
                    firstStableTime = 0;
                })
                .setExecute(() -> {
                    double dx = follower.getPose().getX() - targetPose.getX();
                    double dy = follower.getPose().getY() - targetPose.getY();
                    double xyError = Math.sqrt(dx * dx + dy * dy);

                    double hError = follower.getPose().getHeading() - targetPose.getHeading();
                    while (hError > Math.PI) hError -= 2 * Math.PI;
                    while (hError < -Math.PI) hError += 2 * Math.PI;
                    double hErrorDeg = Math.abs(Math.toDegrees(hError));

                    boolean stableNow = xyError <= PICKUP_XY_TOLERANCE_IN && hErrorDeg <= PICKUP_HEADING_TOLERANCE_DEG;

                    if (stableNow) {
                        if (firstStableTime == 0) firstStableTime = System.currentTimeMillis();
                    } else {
                        firstStableTime = 0;
                    }
                })
                .setDone(() -> {
                    long now = System.currentTimeMillis();
                    return (firstStableTime != 0 && now - firstStableTime >= PICKUP_STABLE_TIME_MS)
                            || (now - stabilizeStartTime >= PICKUP_TIMEOUT_MS);
                });
    }

    public Command scanCommand() {
        return Command.build()
                .setStart(() -> {
                    limelight.start();
                    scanCount = 0;
                    lastScanTime = 0;
                    scanStartTime = System.currentTimeMillis();
                    validDetectionCount = 0;
                    rejectedDetectionCount = 0;
                    voteTL = new HashMap<>(); voteTR = new HashMap<>();
                    voteBL = new HashMap<>(); voteBR = new HashMap<>();
                })
                .setExecute(() -> {
                    long now = System.currentTimeMillis();
                    if (now - scanStartTime < LL_STARTUP_DELAY) return;
                    if (now - lastScanTime < SAMPLE_DELAY) return;
                    if (scanCount >= SAMPLE_COUNT) return;

                    LLResult result = limelight.getLatestResult();
                    if (result != null && result.isValid()) {
                        List<LLResultTypes.DetectorResult> detections = result.getDetectorResults();
                        if (detections != null) {
                            for (LLResultTypes.DetectorResult det : detections) {
                                if (!isGoodDetection(det)) { rejectedDetectionCount++; continue; }
                                Slot slot  = txtyToSlot(det.getTargetXDegrees(), det.getTargetYDegrees());
                                validDetectionCount++;
                                switch (slot) {
                                    case TOP_LEFT:  addVote(voteTL, det.getClassName()); break;
                                    case TOP_RIGHT: addVote(voteTR, det.getClassName()); break;
                                    case BOT_LEFT:  addVote(voteBL, det.getClassName()); break;
                                    case BOT_RIGHT: addVote(voteBR, det.getClassName()); break;
                                }
                            }
                        }
                    }
                    scanCount++;
                    lastScanTime = now;
                })
                .setDone(() -> scanCount >= SAMPLE_COUNT)
                .setEnd(condition -> {
                    boxTL = majority(voteTL); boxTR = majority(voteTR);
                    boxBL = majority(voteBL); boxBR = majority(voteBR);

                    String[] priority = {BOX_1, BOX_2, BOX_3, BOX_4};
                    String[] labels   = {boxTL, boxTR, boxBL, boxBR};
                    Slot[]   slots    = {Slot.TOP_LEFT, Slot.TOP_RIGHT, Slot.BOT_LEFT, Slot.BOT_RIGHT};
                    String[] names    = {"Trên-Trái", "Trên-Phải", "Dưới-Trái", "Dưới-Phải"};

                    lastOrder = new String[4]; lastViTri = new String[4]; lastSlots = new Slot[4];
                    int order = 0;
                    for (String p : priority) {
                        for (int i = 0; i < 4; i++) {
                            if (labels[i] != null && labels[i].equals(p)) {
                                lastOrder[order] = p; lastViTri[order] = names[i]; lastSlots[order] = slots[i];
                                order++;
                            }
                        }
                    }
                    limelight.stop();
                });
    }

    private Command resetServos() {
        return sequential(
            instant(() -> { s1.setPosition(S1_HOME); s2.setPosition(S2_HOME); s3.setPosition(S3_HOME); s4.setPosition(S4_HOME); s5.setPosition(S5_HOME); }),
            waitMs(SERVO_DELAY_MED)
        );
    }

    private Command pickBoxAction(Slot slot) {
        switch (slot) {
            case TOP_LEFT:
                return sequential(
                    instant(() -> s1.setPosition(TL_S1)), waitMs(SERVO_DELAY_MED),
                    instant(() -> s2.setPosition(TL_S2)), waitMs(SERVO_DELAY_SLOW),
                    instant(() -> s3.setPosition(TL_S3)), waitMs(SERVO_DELAY_MED),
                    instant(() -> s4.setPosition(TL_S4)), waitMs(SERVO_DELAY_SLOW),
                    instant(() -> s5.setPosition(TL_S5)), waitMs(SERVO_DELAY_FAST),
                    resetServos()
                );
            case TOP_RIGHT:
                return sequential(
                    instant(() -> s1.setPosition(TR_S1)), waitMs(SERVO_DELAY_MED),
                    instant(() -> s2.setPosition(TR_S2)), waitMs(SERVO_DELAY_SLOW),
                    instant(() -> s3.setPosition(TR_S3)), waitMs(SERVO_DELAY_MED),
                    instant(() -> s4.setPosition(TR_S4)), waitMs(SERVO_DELAY_SLOW),
                    instant(() -> s5.setPosition(TR_S5)), waitMs(SERVO_DELAY_FAST),
                    resetServos()
                );
            case BOT_LEFT:
                return sequential(
                    instant(() -> s1.setPosition(BL_S1)), waitMs(SERVO_DELAY_MED),
                    instant(() -> s2.setPosition(BL_S2)), waitMs(SERVO_DELAY_SLOW),
                    instant(() -> s3.setPosition(BL_S3)), waitMs(SERVO_DELAY_MED),
                    instant(() -> s4.setPosition(BL_S4)), waitMs(SERVO_DELAY_SLOW),
                    instant(() -> s5.setPosition(BL_S5)), waitMs(SERVO_DELAY_FAST),
                    resetServos()
                );
            case BOT_RIGHT:
                return sequential(
                    instant(() -> s1.setPosition(BR_S1)), waitMs(SERVO_DELAY_MED),
                    instant(() -> s2.setPosition(BR_S2)), waitMs(SERVO_DELAY_SLOW),
                    instant(() -> s3.setPosition(BR_S3)), waitMs(SERVO_DELAY_MED),
                    instant(() -> s4.setPosition(BR_S4)), waitMs(SERVO_DELAY_SLOW),
                    instant(() -> s5.setPosition(BR_S5)), waitMs(SERVO_DELAY_FAST),
                    resetServos()
                );
            default: return instant(() -> {});
        }
    }

    public Command dynamicPickSequence() {
        return lazy(() -> {
            List<Command> picks = new ArrayList<>();
            for (int i = 0; i < 4; i++) {
                if (lastOrder[i] != null && !lastOrder[i].equals("--") && lastSlots[i] != null) {
                    picks.add(pickBoxAction(lastSlots[i]));
                }
            }
            return picks.isEmpty() ? instant(() -> {}) : sequential(picks.toArray(new Command[0]));
        });
    }

    // Command thực hiện gắp tại một kệ
    public Command shelfRoutine(Pose shelfPose, PathChain pathToShelf) {
        return sequential(
            follow(follower, pathToShelf, true),
            waitUntilPoseStable(shelfPose),
            scanCommand(),
            dynamicPickSequence()
        );
    }

    public Command autoRoutine() {
        return sequential(
            shelfRoutine(poseShelf1, pathToS1),
            shelfRoutine(poseShelf2, pathS1toS2),
            shelfRoutine(poseShelf3, pathS2toS3),
            follow(follower, pathS3toEnd, true)
        );
    }

    @Override
    public void runOpMode() {
        Scheduler.reset();
        follower = Constants.createFollower(hardwareMap);
        buildPaths();
        follower.setStartingPose(poseStart);

        limelight = hardwareMap.get(Limelight3A.class, NAME_LIMELIGHT);
        limelight.pipelineSwitch(LL_PIPELINE);

        s1 = hardwareMap.get(Servo.class, NAME_S1);
        s2 = hardwareMap.get(Servo.class, NAME_S2);
        s3 = hardwareMap.get(Servo.class, NAME_S3);
        s4 = hardwareMap.get(Servo.class, NAME_S4);
        s5 = hardwareMap.get(Servo.class, NAME_S5);

        s1.setPosition(S1_HOME); s2.setPosition(S2_HOME); s3.setPosition(S3_HOME); s4.setPosition(S4_HOME); s5.setPosition(S5_HOME);

        waitForStart();
        schedule(autoRoutine());

        while (opModeIsActive()) {
            follower.update();
            Scheduler.execute();

            telemetry.addData("Pose", follower.getPose().toString());
            telemetry.addData("Scan", scanCount + "/" + SAMPLE_COUNT + " (OK=" + validDetectionCount + ")");
            if (scanCount >= SAMPLE_COUNT) {
                telemetry.addData("Shelf Results", "TL:" + boxTL + " TR:" + boxTR + " BL:" + boxBL + " BR:" + boxBR);
            }
            telemetry.update();
        }
        limelight.stop();
    }
}
